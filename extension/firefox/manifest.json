{
  "manifest_version": 2,
  "name": "ContextSwitcher",
  "version": "0.7.0",
  "description": "Focuses, opens, and closes task tabs and windows on ContextSwitcher context switches.",
  "permissions": ["tabs", "tabGroups", "storage"],
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "ContextSwitcher",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "options_ui": {
    "page": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@contextswitcher.org",
      "strict_min_version": "115.0"
    }
  }
}
